    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axios": "^1.21.1",
    "eslint": "10.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draggable": "^4.7.2",
    "react-virtuoso": "^4.18.21",
