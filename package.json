{
  "name": "@elqora/dgp-ordering-form-palette",
  "version": "1.1.4",
  "description": "Optional React and Form Palette integration for DGP Ordering.",
  "license": "GPL-3.0-only",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "packageManager": "npm@11.6.4",
  "repository": {
    "type": "git",
